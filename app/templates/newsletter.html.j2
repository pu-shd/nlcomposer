<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ issue.effective_subject() }}</title>
<style type="text/css">
  /* Inline styles remain the desktop default — these only fire on small
     viewports and on email clients that honor <style> blocks (Apple Mail,
     iOS Mail, Gmail web/Android, Outlook for Mac). Outlook on Windows
     ignores @media and falls back to the inline 640px layout. */
  @media only screen and (max-width: 480px) {
    table.container { width: 100% !important; }
    .masthead-h1   { font-size: 22px !important; }
    .article-pad   { padding: 14px 14px 0 14px !important; }
    .article-h3    { font-size: 17px !important; line-height: 1.3 !important; }
    .article-body  { font-size: 15px !important; line-height: 1.55 !important; }
    .pub-icon      { width: auto !important; height: 18px !important; }
    .podcast-pad   { padding: 20px 14px 0 14px !important; }
    .podcast-h3    { font-size: 17px !important; }
    .podcast-title,
    .podcast-summary,
    .podcast-list  { font-size: 15px !important; line-height: 1.55 !important; }
    .static-pad    { padding: 20px 14px 0 14px !important; font-size: 15px !important; line-height: 1.55 !important; }
    .static-h3     { font-size: 16px !important; }
    .highlights-pad  { padding: 24px 14px 0 14px !important; }
    .highlights-list { font-size: 15px !important; line-height: 1.55 !important; }
    .footer-pad    { padding: 26px 14px 18px 14px !important; }
  }
  .article-body span { display: inline; }
  .rt-inline p { display: inline; margin: 0; }
  .rt-inline p + p::before { content: "\A\A"; white-space: pre-wrap; }
  .static-pad table {
    border-collapse: collapse;
    width: 100%;
    margin: 10px 0;
  }
  .static-pad td {
    border: 1px solid #ddd;
    padding: 6px 8px;
  }
</style>
</head>
<body style="margin:0;padding:0;background:#ffffff;font-family:'Times New Roman',Times,Georgia,serif;color:#222222;">
<div style="margin:0 auto;max-width:640px;width:100%;">
<table role="presentation" align="center" width="640" cellpadding="0" cellspacing="0" border="0" class="container" style="width:100%;margin:0 auto;">

  {# ── MASTHEAD ─────────────────────────────────────────────────────── #}
  <tr><td style="padding:18px 16px 6px 16px;text-align:center;">
    {%- if issue.masthead_logo_cid %}
      {# Inline-embedded via build_eml — the email reader resolves cid: locally. #}
      <img src="cid:{{ issue.masthead_logo_cid }}" alt="{{ issue.newsletter_name }}" style="max-width:100%;height:auto;display:inline-block;border:0;">
    {%- elif issue.masthead_logo_media_id %}
      {# In-browser preview only: the eml controller swaps this for a cid: at build time. #}
      <img src="/api/media/{{ issue.masthead_logo_media_id }}/content" alt="{{ issue.newsletter_name }}" style="max-width:100%;height:auto;display:inline-block;border:0;">
    {%- elif issue.masthead_logo_url %}
      <img src="{{ issue.masthead_logo_url }}" alt="{{ issue.newsletter_name }}" style="max-width:100%;height:auto;display:inline-block;border:0;">
    {%- else %}
      <h1 class="masthead-h1" style="font-family:'Times New Roman',Times,Georgia,serif;color:#1a4480;margin:0;font-size:24px;">{{ issue.newsletter_name }}</h1>
    {%- endif %}
  </td></tr>

  {# ── HEADER LINE ──────────────────────────────────────────────────── #}
  <tr><td style="padding:4px 16px 0 16px;text-align:center;font-size:14px;color:#444;">
    <p style="margin:0 0 8px 0;"><strong>{{ issue.effective_display_date() }}</strong></p>
    <p style="margin:0 0 8px 0;">{{ issue.header_slug() }}</p>
    <p style="margin:0;font-style:italic;">{{ issue.edition_line() }}</p>
  </td></tr>

  {# ── INTRO ───────────────────────────────────────────────────────── #}
  {%- if issue.intro_html %}
  <tr><td style="padding:14px 16px 0 16px;font-size:15px;line-height:1.45;">
    {{ issue.intro_html | safe }}
  </td></tr>
  {%- endif %}

  {# ── BODY: articles / podcast / static blocks in form_sections order  #}
  {# rendered_sections() yields the user's dragged section order. With no
     form_sections payload the helper falls back to the legacy fixed
     order (articles → podcast → static blocks) so older drafts and any
     direct API caller still render exactly as before. #}
  {%- for section in issue.rendered_sections() %}
    {%- if section.type == "articles" %}
      {%- for article in section.articles %}
      <tr><td class="article-pad" style="padding:18px 16px 0 16px;">
        <h3 class="article-h3" style="font-family:'Times New Roman',Times,Georgia,serif;font-size:18px;margin:0 0 6px 0;line-height:1.25;">
          {%- if article.publication_logo_media_id %}
            {# Preview-time render of an uploaded article logo. Mail-client
               inline embedding is the planned `embed_all_media` work. #}
            <img class="pub-icon" src="/api/media/{{ article.publication_logo_media_id }}/content" alt="" height="20" style="vertical-align:middle;margin-right:6px;border:0;width:auto;">
          {%- elif article.publication_logo_url %}
            <img class="pub-icon" src="{{ article.publication_logo_url }}" alt="" height="20" style="vertical-align:middle;margin-right:6px;border:0;width:auto;">
          {%- endif %}
          <a href="{{ article.url }}" style="color:#1a4480;text-decoration:none;">{{ article.headline }}</a>
        </h3>
        <div class="article-body" style="font-size:14px;line-height:1.5;color:#222;">
          {%- set parts = [] %}
          {%- if article.byline %}{% set _ = parts.append(article.byline) %}{% endif %}
          {%- if article.date_text %}{% set _ = parts.append(article.date_text) %}{% endif %}
          {%- if parts %}<span>{{ parts | join(', ') }},</span> {% endif %}
          {%- if article.pull_quote %}
            <span class="rt-inline">&ldquo;{{ article.pull_quote | safe }}&rdquo;</span>
          {%- endif %}
          {%- if issue.include_read_more_link %}
          <a href="{{ article.effective_read_more_url() }}" style="color:#1a4480;">{{ article.read_more_label }}</a>
          {%- endif %}
          {%- if article.alain_comment %}
            <span class="rt-inline" style="color:#b91c1c;font-style:italic;"> Hmmmm&hellip; {{ article.alain_comment | safe }} Alain</span>
          {%- endif %}
        </div>
      </td></tr>
      {%- endfor %}
    {%- elif section.type == "podcast" %}
      {%- for p in section.podcasts %}
      <tr><td class="podcast-pad" style="padding:24px 16px 0 16px;">
        <h3 class="podcast-h3" style="font-family:'Times New Roman',Times,Georgia,serif;font-size:18px;margin:0 0 6px 0;">
          {{ issue.podcast_title if issue.podcast_title else issue.newsletter_name }}
          {%- if p.zoomcast_url %} <a href="{{ p.zoomcast_url }}" style="color:#1a4480;">ZoomCast{% if p.episode_number %} {{ p.episode_number }}{% endif %}</a> /{% endif %}
          {%- if p.podcast_url %} <a href="{{ p.podcast_url }}" style="color:#1a4480;">Podcasts{% if p.episode_number %} {{ p.episode_number }}{% endif %}</a>{% endif %}
          {%- if p.guest %} - w/{{ p.guest }}{% endif %}
        </h3>
        {%- if p.title %}
          <p class="podcast-title" style="margin:0 0 6px 0;font-size:15px;font-weight:bold;">
            {%- if p.youtube_video_url -%}
              <a href="{{ p.youtube_video_url }}" style="color:#1a4480;text-decoration:none;">{{ p.title }}</a>
            {%- else -%}
              {{ p.title }}
            {%- endif -%}
          </p>
        {%- endif %}
        {%- if p.summary %}
          <p class="podcast-summary" style="margin:0 0 8px 0;font-size:14px;line-height:1.45;word-break:break-word;word-wrap:break-word;overflow-wrap:break-word;">{{ p.summary | urlize(target="_blank") }}</p>
        {%- endif %}
        {%- if p.timecodes %}
        <ul class="podcast-list" style="margin:0;padding-left:20px;font-size:14px;line-height:1.5;word-break:break-word;word-wrap:break-word;overflow-wrap:break-word;">
          {%- for tc in p.timecodes %}
          <li><a href="{{ tc.url }}" style="color:#1a4480;">{{ tc.timecode }}</a> {{ tc.label }}</li>
          {%- endfor %}
        </ul>
        {%- endif %}
      </td></tr>
      {%- endfor %}
    {%- elif section.type == "static_blocks" %}
      {%- for block in section.blocks %}
      <tr><td class="static-pad" style="padding:24px 16px 0 16px;font-size:14px;line-height:1.5;">
        {%- if block.show_title and block.title %}
        <h3 class="static-h3" style="font-family:'Times New Roman',Times,Georgia,serif;font-size:16px;margin:0 0 6px 0;color:#1a4480;">{{ block.title }}</h3>
        {%- endif %}
        {{ block.html | safe }}
      </td></tr>
      {%- endfor %}
    {%- elif section.type == "highlights" %}
      <tr><td class="highlights-pad" style="padding:28px 16px 0 16px;border-top:1px solid #ddd;">
        <h3 class="highlights-h3" style="font-family:'Times New Roman',Times,Georgia,serif;font-size:16px;margin:12px 0 8px 0;">Highlights</h3>
        {%- for group in section.groups %}
          {# Sub-heading per source issue. With a single group the inner
             heading is redundant with the outer "Highlights" — only emit
             it when the user actually pulled from more than one source. #}
          {%- if section.groups | length > 1 %}
            <h4 class="highlights-h4" style="font-family:'Times New Roman',Times,Georgia,serif;font-size:14px;margin:14px 0 4px 0;color:#555;font-weight:600;">{{ group.label }}</h4>
          {%- endif %}
          <ul class="highlights-list" style="margin:0 0 8px 0;padding-left:20px;font-size:14px;line-height:1.5;">
            {%- for h in group.refs %}
              {%- set _url = h.display_url(issue.articles) %}
              {%- set _label = h.display_label(issue.articles) %}
              {%- if _url and _label %}
                <li><a href="{{ _url }}" style="color:#1a4480;">{{ _label }}</a></li>
              {%- endif %}
            {%- endfor %}
          </ul>
        {%- endfor %}
      </td></tr>
    {%- endif %}
  {%- endfor %}

  {# ── FOOTER ──────────────────────────────────────────────────────── #}
  <tr><td class="footer-pad" style="padding:32px 16px 24px 16px;border-top:1px solid #ddd;font-size:12px;color:#666;text-align:center;">
    {%- if issue.footer_html %}
      {{ issue.footer_html | safe }}
    {%- else %}
      <p style="margin:0 0 6px 0;">This newsletter is maintained by the newsletter editor.</p>
    {%- endif %}
    {%- if issue.unsubscribe_url %}
      <p style="margin:0;">To unsubscribe from this list, click <a href="{{ issue.unsubscribe_url }}" style="color:#1a4480;">here</a>.</p>
    {%- endif %}
  </td></tr>
</table>
</div>
</body>
</html>
