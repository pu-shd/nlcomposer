<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ issue.effective_subject() }}</title>
</head>
<body style="margin:0;padding:0;background:#ffffff;font-family:Arial,Helvetica,sans-serif;color:#222222;">
<table role="presentation" align="center" width="640" cellpadding="0" cellspacing="0" border="0" style="width:640px;max-width:100%;margin:0 auto;">

  {# ── MASTHEAD ─────────────────────────────────────────────────────── #}
  <tr><td style="padding:18px 16px 6px 16px;text-align:center;">
    {%- if issue.masthead_logo_cid %}
      <img src="cid:{{ issue.masthead_logo_cid }}" alt="SmartDrivingCars" style="max-width:100%;height:auto;display:inline-block;border:0;">
    {%- elif issue.masthead_logo_url %}
      <img src="{{ issue.masthead_logo_url }}" alt="SmartDrivingCars" style="max-width:100%;height:auto;display:inline-block;border:0;">
    {%- else %}
      <h1 style="font-family:Arial,Helvetica,sans-serif;color:#1a4480;margin:0;font-size:24px;">SmartDrivingCars</h1>
    {%- endif %}
  </td></tr>

  {# ── HEADER LINE ──────────────────────────────────────────────────── #}
  <tr><td style="padding:4px 16px 0 16px;text-align:center;font-size:14px;color:#444;">
    <strong>{{ issue.effective_display_date() }}</strong><br>
    <span style="font-style:italic;">{{ issue.edition_line() }}</span>
  </td></tr>

  {# ── INTRO ───────────────────────────────────────────────────────── #}
  {%- if issue.intro_html %}
  <tr><td style="padding:14px 16px 0 16px;font-size:15px;line-height:1.45;">
    {{ issue.intro_html | safe }}
  </td></tr>
  {%- endif %}

  {# ── ARTICLES ────────────────────────────────────────────────────── #}
  {%- for article in issue.articles %}
  <tr><td style="padding:18px 16px 0 16px;">
    <h3 style="font-family:Arial,Helvetica,sans-serif;font-size:18px;margin:0 0 6px 0;line-height:1.25;">
      {%- if article.publication_logo_url %}
        <img src="{{ article.publication_logo_url }}" alt="" width="20" height="20" style="vertical-align:middle;margin-right:6px;border:0;">
      {%- endif %}
      <a href="{{ article.url }}" style="color:#1a4480;text-decoration:none;">{{ article.headline }}</a>
    </h3>
    <div style="font-size:14px;line-height:1.5;color:#222;">
      {%- set parts = [] %}
      {%- if article.byline %}{% set _ = parts.append(article.byline) %}{% endif %}
      {%- if article.date_text %}{% set _ = parts.append(article.date_text) %}{% endif %}
      {%- if parts %}<span>{{ parts | join(', ') }},</span> {% endif %}
      {%- if article.pull_quote %}
        <span>&ldquo;{{ article.pull_quote }}&rdquo;</span>
      {%- endif %}
      <a href="{{ article.effective_read_more_url() }}" style="color:#1a4480;">{{ article.read_more_label }}</a>
      {%- if article.alain_comment %}
        <span style="color:#444;"> Hmmmm&hellip; {{ article.alain_comment }} <em>Alain</em></span>
      {%- endif %}
    </div>
  </td></tr>
  {%- endfor %}

  {# ── PODCAST ─────────────────────────────────────────────────────── #}
  {%- if issue.podcast %}
  {%- set p = issue.podcast %}
  <tr><td style="padding:24px 16px 0 16px;">
    <h3 style="font-family:Arial,Helvetica,sans-serif;font-size:18px;margin:0 0 6px 0;">
      SmartDrivingCars
      {%- if p.zoomcast_url %} <a href="{{ p.zoomcast_url }}" style="color:#1a4480;">ZoomCast{% if p.episode_number %} {{ p.episode_number }}{% endif %}</a> /{% endif %}
      {%- if p.podcast_url %} <a href="{{ p.podcast_url }}" style="color:#1a4480;">Podcasts{% if p.episode_number %} {{ p.episode_number }}{% endif %}</a>{% endif %}
      {%- if p.guest %} - w/{{ p.guest }}{% endif %}
    </h3>
    {%- if p.title %}
      <p style="margin:0 0 6px 0;font-size:15px;font-weight:bold;">{{ p.title }}</p>
    {%- endif %}
    {%- if p.summary %}
      <p style="margin:0 0 8px 0;font-size:14px;line-height:1.45;">{{ p.summary }}</p>
    {%- endif %}
    {%- if p.timecodes %}
    <ul style="margin:0;padding-left:20px;font-size:14px;line-height:1.5;">
      {%- for tc in p.timecodes %}
      <li><a href="{{ tc.url }}" style="color:#1a4480;">{{ tc.timecode }}</a> {{ tc.label }}</li>
      {%- endfor %}
    </ul>
    {%- endif %}
  </td></tr>
  {%- endif %}

  {# ── STATIC BLOCKS (sponsor / book / conferences) ────────────────── #}
  {%- for block in issue.static_blocks if block.enabled %}
  <tr><td style="padding:24px 16px 0 16px;font-size:14px;line-height:1.5;">
    {%- if block.title %}
    <h3 style="font-family:Arial,Helvetica,sans-serif;font-size:16px;margin:0 0 6px 0;color:#1a4480;">{{ block.title }}</h3>
    {%- endif %}
    {{ block.html | safe }}
  </td></tr>
  {%- endfor %}

  {# ── BOTTOM HIGHLIGHTS REPEAT ────────────────────────────────────── #}
  {%- if issue.highlights %}
  <tr><td style="padding:28px 16px 0 16px;border-top:1px solid #ddd;">
    <h3 style="font-family:Arial,Helvetica,sans-serif;font-size:16px;margin:12px 0 8px 0;">Highlights</h3>
    <ul style="margin:0;padding-left:20px;font-size:14px;line-height:1.5;">
      {%- for h in issue.highlights %}
        {%- if h.article_index < issue.articles | length %}
          {%- set a = issue.articles[h.article_index] %}
          <li><a href="{{ a.url }}" style="color:#1a4480;">{{ h.override_label or a.headline }}</a></li>
        {%- endif %}
      {%- endfor %}
    </ul>
  </td></tr>
  {%- endif %}

  {# ── FOOTER ──────────────────────────────────────────────────────── #}
  <tr><td style="padding:32px 16px 24px 16px;border-top:1px solid #ddd;font-size:12px;color:#666;text-align:center;">
    {%- if issue.footer_html %}
      {{ issue.footer_html | safe }}
    {%- else %}
      <p style="margin:0 0 6px 0;">This list is maintained by the SmartDrivingCars team.</p>
    {%- endif %}
    {%- if issue.unsubscribe_url %}
      <p style="margin:0;">To unsubscribe from this list, click <a href="{{ issue.unsubscribe_url }}" style="color:#1a4480;">here</a>.</p>
    {%- endif %}
  </td></tr>
</table>
</body>
</html>
