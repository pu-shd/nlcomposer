# Deployment targets for one newsletter. Not secret: never put credentials here.
# Read by the engine's scripts/deploy.sh (operator: setup, domain, teardown)
# and scripts/ci-deploy.sh (CI: AZ_RG, AZ_ACR, AZ_ACA_APP, AZ_CUSTOM_DOMAIN).
AZ_SUBSCRIPTION="00000000-0000-0000-0000-000000000000"
AZ_LOCATION="canadacentral"
AZ_RG="rg-example-nlcomposer"
AZ_STORAGE="stexamplenlcomposer"
AZ_FILE_SHARE="example-data"
AZ_ACR="acrexamplenlcomposer"
AZ_ACA_ENV="cae-example-nlcomposer"
AZ_ACA_APP="example-nlcomposer"
AZ_ENTRA_APP="Example Newsletter Composer (auth)"
AZ_ENTRA_PRINCIPALS=""
AZ_ENTRA_MINIMAL_PERMS="true"
AZ_CUSTOM_DOMAIN="composer.example.edu"
AZ_CI_IDENTITY="id-example-nlcomposer-ci"
GH_REPO="pu-example/nlcomposer-config"
GH_ENVIRONMENT="example"
